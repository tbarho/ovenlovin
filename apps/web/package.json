    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ovenlovin/allergens": "workspace:*",
    "@ovenlovin/brand": "workspace:*",
    "@ovenlovin/core": "workspace:*",
    "@ovenlovin/db": "workspace:^",
    "@ovenlovin/importers": "workspace:*",
    "@ovenlovin/mcp": "workspace:*",
    "@sparticuz/chromium": "^133.0.0",
    "@vercel/blob": "^2.8.1",
