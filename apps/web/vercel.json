{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm install --prod=false && pnpm turbo run build --filter=@ovenlovin/web... && pnpm exec tsx packages/db/src/migrate.ts",
  "functions": {
    "src/app/api/demo/enter/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/v1/recipes/import/photo/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/demo-cleanup",
      "schedule": "0 8 * * *"
    }
  ]
}
