{
  "openapi": "3.1.0",
  "info": {
    "version": "0.1.0",
    "title": "OvenLovin API",
    "description": "The family recipe box your AI can actually use, and it knows who can't eat what. REST for agents. Not medical advice — always check labels.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/tbarho/ovenlovin/blob/main/LICENSE"
    },
    "contact": {
      "name": "OvenLovin",
      "url": "https://github.com/tbarho/ovenlovin"
    }
  },
  "servers": [
    {
      "url": "https://ovenlovin.vercel.app/api/v1",
      "description": "This OvenLovin instance"
    },
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "apiKey": []
    },
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Household API key. Send `ApiKey rkapi_…` or `Bearer rkapi_…`. Create a key under Settings."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key or Clerk JWT",
        "description": "Same API key as `rkapi_…` (ChatGPT Actions often send Bearer) or a Clerk session JWT."
      }
    },
    "schemas": {
      "Recipe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "householdId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "servings": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "prepTimeMinutes": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "cookTimeMinutes": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "totalTimeMinutes": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "needs_review",
              "published"
            ]
          },
          "cuisine": {
            "type": "string",
            "nullable": true
          },
          "course": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "householdId",
          "title",
          "slug",
          "images",
          "status"
        ]
      },
      "CookbookCard": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Cookbook"
          },
          {
            "type": "object",
            "properties": {
              "recipeCount": {
                "type": "integer",
                "minimum": 0
              },
              "previewImages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recipeCount",
              "previewImages"
            ]
          }
        ]
      },
      "Cookbook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "householdId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "householdId",
          "name",
          "slug",
          "sortOrder"
        ]
      },
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "householdId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "householdId",
          "displayName",
          "sortOrder"
        ]
      },
      "Preference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "personId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "weight": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "personId",
          "type",
          "value",
          "weight"
        ]
      },
      "PersonRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "personId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "allergen",
              "ingredient",
              "ingredient_category",
              "diet",
              "tag",
              "custom"
            ]
          },
          "target": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "prefer_avoid"
            ]
          },
          "label": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "personId",
          "kind",
          "target",
          "severity"
        ]
      },
      "MealPlan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "householdId": {
            "type": "string",
            "format": "uuid"
          },
          "weekStart": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "approved",
              "archived"
            ]
          },
          "needsRecheck": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "householdId",
          "weekStart",
          "status",
          "needsRecheck"
        ]
      },
      "MealPlanDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MealPlan"
          },
          {
            "type": "object",
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MealPlanEntry"
                }
              }
            },
            "required": [
              "entries"
            ]
          }
        ]
      },
      "MealPlanEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string"
          },
          "mealSlot": {
            "type": "string"
          },
          "recipeId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "servings": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "prepAheadNotes": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "date",
          "mealSlot",
          "attendees"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/recipes": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "List recipes",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "maximum": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "search",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "cookbookId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "uncategorized",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Recipe"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Create a recipe directly (title, ingredients, steps)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "servings": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "prepTimeMinutes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cookTimeMinutes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ingredients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rawText": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rawText"
                      ]
                    }
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "text"
                      ]
                    }
                  },
                  "cookbookId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created recipe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{id}": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Get a recipe with ingredients, steps, times, images, and source",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "recipes"
        ],
        "summary": "Update recipe metadata, ingredients, steps, images, or cookbook membership",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "servings": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "prepTimeMinutes": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "cookTimeMinutes": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "totalTimeMinutes": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cookbookIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "ingredients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rawText": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rawText"
                      ]
                    }
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "text"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated recipe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "recipes"
        ],
        "summary": "Soft-delete a recipe",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/recipes/import": {
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Import a recipe from a URL or pasted text, copying the main image into Vercel Blob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "url",
                      "paste"
                    ]
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "content"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Imported recipe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          }
        }
      }
    },
    "/cookbooks": {
      "get": {
        "tags": [
          "cookbooks"
        ],
        "summary": "List cookbooks",
        "responses": {
          "200": {
            "description": "Cookbook page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CookbookCard"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "cookbooks"
        ],
        "summary": "Create a cookbook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created cookbook",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cookbook"
                }
              }
            }
          }
        }
      }
    },
    "/cookbooks/{id}": {
      "get": {
        "tags": [
          "cookbooks"
        ],
        "summary": "Get a cookbook and its recipes",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Cookbook",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cookbook"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "cookbooks"
        ],
        "summary": "Rename a cookbook",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated cookbook",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cookbook"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "cookbooks"
        ],
        "summary": "Delete a cookbook without deleting its recipes",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/cookbooks/{id}/recipes": {
      "post": {
        "tags": [
          "cookbooks"
        ],
        "summary": "Add a recipe to a cookbook",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipeId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "recipeId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Membership saved"
          }
        }
      }
    },
    "/people/reorder": {
      "post": {
        "tags": [
          "people"
        ],
        "summary": "Set the persistent household people order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "personIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "personIds"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "People in the saved order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Person"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/people/{id}/preferences": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "List a person's preferences, including Loves",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "type",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Preferences",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Preference"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "people"
        ],
        "summary": "Add a preference such as a Love (never filters recipes)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer"
                  }
                },
                "required": [
                  "value"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created preference",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preference"
                }
              }
            }
          }
        }
      }
    },
    "/people/{id}/preferences/{prefId}": {
      "delete": {
        "tags": [
          "people"
        ],
        "summary": "Remove a preference",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "prefId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/uploads/images": {
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Upload or copy a recipe image into Vercel Blob",
        "responses": {
          "201": {
            "description": "Stored image URL",
            "content": {
              "application/json": {
                "schema": {
