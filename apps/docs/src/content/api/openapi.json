          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "weekStart": {
                    "type": "string",
                    "format": "date"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "approved"
                    ]
