                        },
                        "meal": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50
                        },
                        "recipeId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "servings": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true
                        },
                        "attendees": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "default": []
                        },
                        "prepAheadNotes": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "date",
                        "meal"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "weekStart"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created plan",
