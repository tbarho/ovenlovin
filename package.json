{
  "name": "ovenlovin",
  "version": "0.1.0",
  "private": true,
  "description": "The family recipe box your AI can actually use, and it knows who can't eat what.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbarho/ovenlovin.git"
  },
  "license": "MIT",
  "author": "Ty Barho",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:dashes": "node scripts/check-no-em-en-dashes.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "e2e:kitchen": "pnpm --filter @ovenlovin/web e2e:kitchen",
    "e2e:kitchen:seed": "pnpm --filter @ovenlovin/web e2e:kitchen:seed",
    "db:migrate": "pnpm --filter @ovenlovin/db db:migrate:deploy"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
