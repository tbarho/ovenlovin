# Database
DATABASE_URL=postgresql://ovenlovin:ovenlovin@localhost:5432/ovenlovin

# Signed-in e2e kitchen (never set on a Vercel production deploy)
# E2E_AUTH_BYPASS=1

# Public demo - dedicated Vercel project only (never on product production)
# OVENLOVIN_DEMO_MODE=1
# OVENLOVIN_DEMO_PROJECT=1
# CRON_SECRET=
# NEXT_PUBLIC_DEMO_URL=

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: sign-in/up URLs default to the in-app /sign-in and /sign-up pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shown on the landing page so a deploy feels like the owner's kitchen
NEXT_PUBLIC_INSTANCE_NAME=Your OvenLovin
NEXT_PUBLIC_APP_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
# Optional pin for book PDF URLs (defaults from the token store id)
BLOB_STORE_HOST=

# AI (Vercel AI Gateway)
AI_GATEWAY_API_KEY=
RK_MODEL_DEFAULT=deepseek/deepseek-v4.1-flash
RK_MODEL_VISION=deepseek/deepseek-v4.1-flash
# Optional: stronger model for "Try a sharper read" only. Blank = RK_MODEL_VISION
# RK_MODEL_VISION_ENHANCED=
# RK_MODEL_EXTRACT=deepseek/deepseek-v4.1-flash

# URL import (optional; 0 skips Google Translate / Jina public copies)
# RECIPE_IMPORT_CACHE_FALLBACK=0
# Optional iCloud link for "Add the OvenLovin Shortcut". Leave unset to show manual steps only.
# NEXT_PUBLIC_IOS_SHORTCUT_URL=

# USDA FoodData Central (not read today)
# USDA_FDC_API_KEY=

# Vercel dashboard links on the landing page (team slug is not the GitHub owner)
# OVENLOVIN_VERCEL_TEAM_SLUG=ty-barho
# OVENLOVIN_VERCEL_PROJECT_SLUG=ovenlovin
# VERCEL_TOKEN=
