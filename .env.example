# Database
DATABASE_URL=postgresql://ovenlovin:ovenlovin@localhost:5432/ovenlovin

# Signed-in e2e kitchen (never set on a Vercel production deploy)
# E2E_AUTH_BYPASS=1

# Public demo - dedicated Vercel project only (never on product production)
# OVENLOVIN_DEMO_MODE=1
# OVENLOVIN_DEMO_PROJECT=1
# CRON_SECRET=
# NEXT_PUBLIC_DEMO_URL=

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shown on the landing page so a deploy feels like the owner's kitchen
NEXT_PUBLIC_INSTANCE_NAME=Your OvenLovin
NEXT_PUBLIC_APP_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# AI (Vercel AI Gateway)
AI_GATEWAY_API_KEY=
RK_MODEL_DEFAULT=spacexai/grok-4.7
RK_MODEL_VISION=spacexai/grok-4.7
RK_MODEL_STT=openai/whisper-1

# URL import (optional remote browser - leave unset unless Ty adds keys)
# RECIPE_IMPORT_HEADLESS=0
# RECIPE_IMPORT_CACHE_FALLBACK=0
# RECIPE_IMPORT_SCRAPE=0
# BROWSERLESS_URL=
# BROWSERLESS_TOKEN=
# SCRAPINGBEE_API_KEY=
# RECIPE_IMPORT_SCRAPE_URL=
# RECIPE_IMPORT_SCRAPE_TOKEN=

# USDA FoodData Central
USDA_FDC_API_KEY=

# Vercel dashboard links on the landing page (team slug is not the GitHub owner)
# OVENLOVIN_VERCEL_TEAM_SLUG=ty-barho
# OVENLOVIN_VERCEL_PROJECT_SLUG=ovenlovin
# VERCEL_TOKEN=
